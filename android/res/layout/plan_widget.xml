<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✳ PlanWithMe" android:textSize="19sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp"/>
<TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="На сегодня пока нет задач. Добавьте маленький шаг ♧" android:textSize="14sp"/>
<TextView android:id="@+id/widget_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end" android:textSize="14sp"/>
<TextView android:id="@+id/widget_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textSize="14sp"/>
<TextView android:id="@+id/widget_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textSize="14sp"/>
<TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:gravity="center_vertical" android:text="Открыть задачи →" android:textSize="12sp"/>
<TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="48dp" android:gravity="center" android:text="↻" android:textSize="24sp" android:contentDescription="Обновить виджет"/>
</LinearLayout></LinearLayout>
